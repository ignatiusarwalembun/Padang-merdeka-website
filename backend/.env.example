PORT=3000
NODE_ENV=development
# Untuk production Railway: isi URL Netlify. Bisa beberapa origin dipisahkan koma.
FRONTEND_ORIGINS=http://localhost:5510,http://127.0.0.1:5510,https://YOUR-NETLIFY-SITE.netlify.app
ADMIN_API_KEY=change-this-admin-key
POS_CONNECTOR_TOKEN=change-this-pos-token
# Railway PostgreSQL akan menyediakan DATABASE_URL. Kosong = JSON store lokal.
DATABASE_URL=
